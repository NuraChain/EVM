# Copy this file to nura.env and edit it on each VPS.
# Do not commit nura.env or any key material.

# --- Identity ---------------------------------------------------------------

CHAIN_ID="nura_22-1"

# EIP-155 replay-protection chain ID, separate from CHAIN_ID above. It MUST be
# identical on every validator or nodes will disagree on which signatures are
# valid. It MUST NOT be left at cosmos/evm's default of 262144, which is shared
# with every unconfigured test chain. Claim a free ID on https://chainlist.org
# before launch.
EVM_CHAIN_ID="22"

MONIKER="validator-1"

# --- Paths and users --------------------------------------------------------

NODE_HOME="/home/EVM/.evmd"
GENESIS_HOME="/home/EVM/.evmd/evmd-genesis"

# Unprivileged system account that owns NODE_HOME and runs the node.
# Created by 06_install_service.sh.
NODE_USER="evmd"

# --- Keys -------------------------------------------------------------------

VALIDATOR_KEY="validator"
# "test" is rejected by the scripts; it stores keys unencrypted on disk.
KEYRING_BACKEND="file"

# --- Denomination (18 decimals) ---------------------------------------------

DENOM="anura"
DISPLAY_DENOM="nura"
SYMBOL="NURA"

# --- Gas pricing ------------------------------------------------------------

# Denom-per-gas, in base units. This single value feeds both the
# consensus-enforced feemarket floor in genesis and each node's local
# minimum-gas-prices, so the two cannot drift apart.
# 1000000000 = 1 gwei-equivalent.
MIN_GAS_PRICE_WEI="1000000000"
BASE_FEE_WEI="1000000000"

# --- Genesis economics ------------------------------------------------------

# Whole-token amounts. The scripts append the 18 zeros.
GENESIS_BALANCE="1000000"
GENTX_SELF_DELEGATION="100000"
GOV_MIN_DEPOSIT="10000"
GOV_EXPEDITED_MIN_DEPOSIT="50000"

# Maximum gas per block. CometBFT's default of -1 means "unlimited", which lets
# a single transaction consume an entire block.
BLOCK_MAX_GAS="100000000"

# Target seconds per block. Used to derive mint.params.blocks_per_year so that
# inflation is paid at the intended annual rate.
SECONDS_PER_BLOCK="3"

# Coordinated launch time, RFC3339 UTC, e.g. "2026-09-01T12:00:00Z".
# Leave empty to keep whatever `evmd init` generated.
GENESIS_TIME="2026-06-06T00:00:00Z"

# --- Wrapped native ERC-20 --------------------------------------------------

# The WNURA contract address. Any otherwise-unused address is valid, but it
# CANNOT be changed after launch. Do not reuse cosmos/evm's example WEVMOS
# address (0xD4949664cD82660AaE99bEdc034a0deA8A0bd517).
WRAPPED_NATIVE_ADDRESS="0x0000000000000000000000000000000000000900"

# --- JSON-RPC ---------------------------------------------------------------

# Disabled by default in cosmos/evm, so without this an EVM chain ships with no
# Ethereum RPC at all. Keep it bound to loopback and front it with an
# authenticated TLS reverse proxy.
JSONRPC_ENABLE="true"
JSONRPC_ADDRESS="127.0.0.1:8545"
JSONRPC_WS_ADDRESS="127.0.0.1:8546"
# Never add "personal", "debug", or "miner" here on a public node.
JSONRPC_NAMESPACES="eth,net,web3"
# Required for eth_getLogs / eth_getTransactionReceipt over historical blocks.
JSONRPC_ENABLE_INDEXER="true"

# --- CometBFT peering (set per host) ----------------------------------------

# Comma-separated "nodeid@host:26656" entries for the other validators.
PERSISTENT_PEERS=""
# This host's publicly reachable "host:26656", if behind NAT.
EXTERNAL_ADDRESS=""

PRUNING="default"

# --- Coordinator-only settings ----------------------------------------------

# Comma-separated account addresses, one per validator, for 02_prepare_genesis.sh.
VALIDATOR_ADDRESSES=""
# Comma-separated gentx file paths for 04_collect_genesis.sh.
GENTX_FILES=""

# --- Genesis verification ---------------------------------------------------

# SHA256 of the final genesis.json, published by the coordinator after
# 04_collect_genesis.sh. Each validator sets this so 05_configure_node.sh can
# prove it holds a byte-identical genesis before starting.
GENESIS_SHA256=""
